.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Python
.venv/
__pycache__/
.pytest_cache/

# Secrets
.env
spec.md

# Variant Copilot: local expert reviews (reviewer names), not committed
apps/variant-copilot/backend/data/reviews.jsonl
# Half-written files from atomic writes (cache, runs)
apps/variant-copilot/backend/data/**/*.tmp
